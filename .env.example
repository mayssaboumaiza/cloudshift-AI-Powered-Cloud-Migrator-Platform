

# GitHub
# Obtenir sur : GitHub Settings Developer settings Tokens
GITHUB_TOKEN=


# Azure OpenAI (cognitiveservices.azure.com → utilise AzureChatOpenAI)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# ── Déploiements de modèles (seule convention lue par le code) ──────────────
AZURE_MODEL=gpt-5.1                      # défaut global des 3 agents (raisonnement + function calling)
# AZURE_MODEL_01=gpt-5.1                 # Agent 01 : planification 7R (surcharge optionnelle)
# AZURE_MODEL_02=gpt-5.1                 # Agent 02 : génération Terraform
# AZURE_MODEL_03=gpt-5.4-mini            # Agent 03 : deploy.sh + CI/CD (modèle plus léger)
AZURE_MODEL_RAG=gpt-4o                   # chatbot GraphRAG uniquement (modèle plus léger)
# AZURE_MAX_TOKENS=8192                  # Limite tokens sortie Agent 02
# AZURE_REQUEST_TIMEOUT=180              # Timeout HTTP (secondes) — défaut 180s

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Neo4j (Graph RAG — Cypher traversal)
# Docker: URI auto-set to bolt://neo4j:7687 by docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cloud-migrator

# Infracost — Agent 01 pricing fallback (Infracost GraphQL API)
# Clé gratuite : https://www.infracost.io/docs/#2-get-api-key
# Même clé utilisée par le service MCP (Agent 02 : infracost breakdown CLI)
INFRACOST_API_KEY=

# Callback optionnel : URL appelée après terraform apply (ex: webhook notification)
# Ex: http://ton-api.example.com/api/v1/migration-callback
MIGRATION_CALLBACK_URL=

# Executor worker → API callback auth (generate with: openssl rand -hex 32)
INTERNAL_SERVICE_TOKEN=

# Vault — token + unseal keys
# VAULT_TOKEN : token applicatif (AppRole ou root pour dev)
# VAULT_UNSEAL_KEY_1/2/3 : 3 des 5 clés générées par `vault operator init`
#   → copiées ici pour que le service vault-unsealer déscelle Vault automatiquement
#   → ne jamais committer ces valeurs dans git
VAULT_TOKEN=
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=

# ── Agent behaviour tuning (all optional — production defaults shown) ─────────

# Agent 01 — ReAct loop
MAX_REACT_ITERATIONS=3       # max iterations per batch before discarding

# Agent 02 — IaC fix loop
MAX_CORRECTIONS=3            # max fix attempts per .tf file
MAX_REJECTION_COUNT=2        # max partial-rejection cycles before escalation

# Agent 02 — Intent validation
MAX_INTENT_REGEN=1           # max regenerations triggered by region/budget mismatch
INTENT_BUDGET_TOLERANCE=1.20 # allow cost up to 20% above declared budget

# 7R cosine similarity thresholds (SBERT-calibrated, see docs/scoring_methodology.md)
# Certain zones: eq >= 0.95 → REHOST, 0.82-0.90 → REPLATFORM, < 0.78 → REFACTOR
# Gray zones: 0.90-0.95 → REHOST low-confidence, 0.78-0.82 → REPLATFORM low-confidence
THRESHOLD_REHOST_HIGH=0.95
THRESHOLD_REHOST_LOW=0.90
THRESHOLD_REPLATFORM_HIGH=0.90
THRESHOLD_REPLATFORM_LOW=0.78

# SAW scoring weights — leave at 0.0 to use AHP-computed values (recommended)
# Set non-zero to override AHP for A/B testing (values must sum to 1.0)
# WEIGHT_EQUIVALENCE=0.0
# WEIGHT_MATURITY=0.0
# WEIGHT_BUDGET=0.0
# WEIGHT_REGION=0.0
# WEIGHT_COMPLEXITY=0.0

# Tie-breaking: trigger ask_human when top-2 candidates differ by less than this
SCORE_TIE_THRESHOLD=0.05