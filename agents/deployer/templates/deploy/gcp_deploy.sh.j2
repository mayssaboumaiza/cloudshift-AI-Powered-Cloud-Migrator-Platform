#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# deploy.sh — GCP Deployment Script
# Generated by Cloud Migrator Agent 03
# Provider : GCP | Region : {{ region }} | Project : {{ project_id }}
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REGION="{{ region }}"
PROJECT_ID="{{ project_id }}"
RESOURCES="{{ resources_csv }}"
OUTPUT_DIR="{{ output_dir }}"
TF_WORKSPACE="${TF_WORKSPACE:-default}"

echo "=== Cloud Migrator — GCP Deployment ==="
echo "Project   : $PROJECT_ID"
echo "Region    : $REGION"
echo "Resources : $RESOURCES"
echo "Output    : $OUTPUT_DIR"
echo ""

# ── 1. Validate credentials ──────────────────────────────────────────────────
if [[ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" && -z "${GOOGLE_CREDENTIALS:-}" ]]; then
  echo "ERROR: GOOGLE_APPLICATION_CREDENTIALS or GOOGLE_CREDENTIALS must be set."
  exit 1
fi
echo "[1/5] Credentials: OK (GOOGLE_APPLICATION_CREDENTIALS is set)"
gcloud config set project "$PROJECT_ID" 2>/dev/null || true

# ── 2. Terraform init ────────────────────────────────────────────────────────
echo "[2/5] terraform init..."
cd "$OUTPUT_DIR"
terraform init -input=false \
  {% if backend_bucket %}-backend-config="bucket={{ backend_bucket }}" \
  -backend-config="prefix=terraform/state" \{% endif %}
  2>&1 | tee /tmp/tf_init.log
echo "[2/5] Init: OK"

# ── 3. Terraform workspace ───────────────────────────────────────────────────
echo "[3/5] Workspace: $TF_WORKSPACE"
terraform workspace select "$TF_WORKSPACE" 2>/dev/null || terraform workspace new "$TF_WORKSPACE"

# ── 4. Terraform plan ────────────────────────────────────────────────────────
echo "[4/5] terraform plan..."
terraform plan -input=false -refresh=false \
  -var="project_id=${PROJECT_ID}" \
  -var="region=${REGION}" \
  -out=tfplan.binary 2>&1 | tee /tmp/tf_plan.log
echo "[4/5] Plan: OK"

# ── 5. Terraform apply ───────────────────────────────────────────────────────
echo "[5/5] terraform apply..."
terraform apply -input=false -auto-approve tfplan.binary 2>&1 | tee /tmp/tf_apply.log
echo "[5/5] Apply: DONE"

echo ""
echo "=== Deployment completed successfully ==="
echo "Check resources: https://console.cloud.google.com/home/dashboard?project=${PROJECT_ID}"
