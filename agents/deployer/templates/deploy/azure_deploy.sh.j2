#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# deploy.sh — Azure Deployment Script
# Generated by Cloud Migrator Agent 03
# Provider : Azure | Region : {{ region }}
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REGION="{{ region }}"
RESOURCES="{{ resources_csv }}"
OUTPUT_DIR="{{ output_dir }}"
TF_WORKSPACE="${TF_WORKSPACE:-default}"

echo "=== Cloud Migrator — Azure Deployment ==="
echo "Region    : $REGION"
echo "Resources : $RESOURCES"
echo "Output    : $OUTPUT_DIR"
echo ""

# ── 1. Validate credentials ──────────────────────────────────────────────────
if [[ -z "${ARM_CLIENT_ID:-}" || -z "${ARM_CLIENT_SECRET:-}" || \
      -z "${ARM_TENANT_ID:-}" || -z "${ARM_SUBSCRIPTION_ID:-}" ]]; then
  echo "ERROR: ARM_CLIENT_ID, ARM_CLIENT_SECRET, ARM_TENANT_ID, ARM_SUBSCRIPTION_ID must be set."
  exit 1
fi
echo "[1/8] Credentials: OK (ARM_CLIENT_ID is set)"

# ── 2. Azure login (service principal) ───────────────────────────────────────
echo "[2/8] Azure login..."
az login --service-principal \
  --username "$ARM_CLIENT_ID" \
  --password "$ARM_CLIENT_SECRET" \
  --tenant "$ARM_TENANT_ID" \
  --output none 2>&1 || echo "WARNING: az login failed — continuing with Terraform env vars"

# ── 3. Terraform init ────────────────────────────────────────────────────────
echo "[3/8] terraform init..."
cd "$OUTPUT_DIR"
terraform init -input=false \
  {% if backend_storage_account %}-backend-config="storage_account_name={{ backend_storage_account }}" \
  -backend-config="container_name=tfstate" \
  -backend-config="key=terraform.tfstate" \{% endif %}
  2>&1 | tee /tmp/tf_init.log
echo "[3/8] Init: OK"

# ── 4. Terraform plan ────────────────────────────────────────────────────────
echo "[4/8] terraform plan..."
terraform workspace select "$TF_WORKSPACE" 2>/dev/null || terraform workspace new "$TF_WORKSPACE"
terraform plan -input=false -refresh=false \
  -var="location=${REGION}" \
  -out=tfplan.binary 2>&1 | tee /tmp/tf_plan.log
echo "[4/8] Plan: OK"

# ── 5. Terraform apply ───────────────────────────────────────────────────────
echo "[5/8] terraform apply..."
terraform apply -input=false -auto-approve tfplan.binary 2>&1 | tee /tmp/tf_apply.log
echo "[5/8] Apply: DONE"

# ── 6. Data migration — S3 → Azure Blob Storage ──────────────────────────────
{% if has_s3_migration %}
echo "[6/8] Data migration: S3 → Azure Blob Storage..."

# Read Azure Storage outputs from Terraform
AZURE_STORAGE_ACCOUNT=$(terraform output -raw storage_account_name 2>/dev/null || echo "${AZURE_STORAGE_ACCOUNT_NAME:-}")
AZURE_STORAGE_CONTAINER=$(terraform output -raw storage_container_name 2>/dev/null || echo "${AZURE_STORAGE_CONTAINER_NAME:-exports}")

if [[ -z "${AWS_S3_BUCKET:-}" ]]; then
  echo "  ⚠️  AWS_S3_BUCKET not set — skipping S3 data migration."
  echo "     Set AWS_S3_BUCKET=<your-source-bucket> and re-run to migrate data."
elif [[ -z "${AZURE_STORAGE_ACCOUNT:-}" ]]; then
  echo "  ⚠️  Could not determine Azure storage account — skipping S3 data migration."
else
  echo "  Source : s3://${AWS_S3_BUCKET}"
  echo "  Target : https://${AZURE_STORAGE_ACCOUNT}.blob.core.windows.net/${AZURE_STORAGE_CONTAINER}"

  # Get Azure storage key
  AZURE_STORAGE_KEY=$(az storage account keys list \
    --account-name "$AZURE_STORAGE_ACCOUNT" \
    --subscription "$ARM_SUBSCRIPTION_ID" \
    --query '[0].value' -o tsv 2>/dev/null || echo "")

  if [[ -z "$AZURE_STORAGE_KEY" ]]; then
    echo "  ⚠️  Could not retrieve Azure storage key — skipping S3 migration."
  else
    # Use azcopy if available, otherwise aws s3 sync + az storage blob upload-batch
    if command -v azcopy &>/dev/null; then
      AZURE_SAS_URL="https://${AZURE_STORAGE_ACCOUNT}.blob.core.windows.net/${AZURE_STORAGE_CONTAINER}?$(az storage container generate-sas \
        --account-name "$AZURE_STORAGE_ACCOUNT" \
        --account-key "$AZURE_STORAGE_KEY" \
        --name "$AZURE_STORAGE_CONTAINER" \
        --permissions acdlrw \
        --expiry "$(date -u -d '+2 hours' '+%Y-%m-%dT%H:%MZ' 2>/dev/null || date -u -v+2H '+%Y-%m-%dT%H:%MZ')" \
        -o tsv 2>/dev/null)"
      azcopy copy "s3://${AWS_S3_BUCKET}/*" "$AZURE_SAS_URL" --recursive \
        2>&1 | tee /tmp/s3_migration.log
      echo "  ✅ S3 → Blob migration completed via azcopy."
    else
      # Fallback: download locally then upload
      TMP_DIR=$(mktemp -d)
      echo "  Downloading from S3 to temp dir..."
      aws s3 sync "s3://${AWS_S3_BUCKET}" "$TMP_DIR" --quiet 2>&1 | tee /tmp/s3_download.log
      echo "  Uploading to Azure Blob..."
      az storage blob upload-batch \
        --source "$TMP_DIR" \
        --destination "$AZURE_STORAGE_CONTAINER" \
        --account-name "$AZURE_STORAGE_ACCOUNT" \
        --account-key "$AZURE_STORAGE_KEY" \
        --overwrite true \
        2>&1 | tee /tmp/blob_upload.log
      rm -rf "$TMP_DIR"
      echo "  ✅ S3 → Blob migration completed via aws cli + az cli."
    fi
  fi
fi
{% else %}
echo "[6/8] Data migration (S3): skipped — no S3 bucket in migration plan."
{% endif %}

# ── 7. Data migration — PostgreSQL (RDS) → Azure PostgreSQL ─────────────────
{% if has_postgres_migration %}
echo "[7/8] Data migration: PostgreSQL (RDS) → Azure PostgreSQL Flexible Server..."

# Read Azure PostgreSQL outputs from Terraform
AZURE_PG_HOST=$(terraform output -raw postgresql_server_fqdn 2>/dev/null || echo "${AZURE_PG_HOST:-}")
AZURE_PG_USER=$(terraform output -raw postgresql_admin_login 2>/dev/null || echo "${AZURE_PG_ADMIN:-azureadmin}")
AZURE_PG_DB=$(terraform output -raw postgresql_database_name 2>/dev/null || echo "${AZURE_PG_DB_NAME:-appdb}")

if [[ -z "${SOURCE_DB_URL:-}" ]]; then
  echo "  ⚠️  SOURCE_DB_URL not set — skipping PostgreSQL data migration."
  echo "     Set SOURCE_DB_URL=postgresql://user:pass@host:5432/dbname and re-run."
elif [[ -z "${AZURE_PG_HOST:-}" ]]; then
  echo "  ⚠️  Could not determine Azure PostgreSQL host — skipping DB migration."
elif [[ -z "${AZURE_PG_PASSWORD:-}" ]]; then
  echo "  ⚠️  AZURE_PG_PASSWORD not set — skipping PostgreSQL data migration."
  echo "     Set AZURE_PG_PASSWORD=<your-azure-pg-password> and re-run."
else
  echo "  Source : $SOURCE_DB_URL"
  echo "  Target : ${AZURE_PG_USER}@${AZURE_PG_HOST}/${AZURE_PG_DB}"

  DUMP_FILE="/tmp/pg_migration_$(date +%Y%m%d_%H%M%S).dump"

  echo "  Dumping source PostgreSQL database..."
  pg_dump \
    --format=custom \
    --no-owner \
    --no-acl \
    --file="$DUMP_FILE" \
    "$SOURCE_DB_URL" \
    2>&1 | tee /tmp/pg_dump.log

  if [[ $? -ne 0 ]]; then
    echo "  ❌ pg_dump failed — check /tmp/pg_dump.log. DB migration skipped."
  else
    echo "  Dump size: $(du -sh "$DUMP_FILE" | cut -f1)"
    echo "  Restoring to Azure PostgreSQL..."

    PGPASSWORD="$AZURE_PG_PASSWORD" pg_restore \
      --host="$AZURE_PG_HOST" \
      --port=5432 \
      --username="$AZURE_PG_USER" \
      --dbname="$AZURE_PG_DB" \
      --no-owner \
      --no-acl \
      --clean \
      --if-exists \
      "$DUMP_FILE" \
      2>&1 | tee /tmp/pg_restore.log

    if [[ $? -ne 0 ]]; then
      echo "  ⚠️  pg_restore finished with warnings — check /tmp/pg_restore.log."
    else
      echo "  ✅ PostgreSQL data migration completed."
    fi
    rm -f "$DUMP_FILE"
  fi
fi
{% else %}
echo "[7/8] Data migration (PostgreSQL): skipped — no PostgreSQL in migration plan."
{% endif %}

# ── 8. Post-deployment health checks ─────────────────────────────────────────
echo "[8/8] Post-deployment health checks..."

HEALTH_PASS=0
HEALTH_FAIL=0

{% if has_postgres_migration %}
# Check: Azure PostgreSQL connectivity
AZURE_PG_HOST_CHECK=$(terraform output -raw postgresql_server_fqdn 2>/dev/null || echo "${AZURE_PG_HOST:-}")
if [[ -n "$AZURE_PG_HOST_CHECK" ]]; then
  if nc -z -w5 "$AZURE_PG_HOST_CHECK" 5432 2>/dev/null; then
    echo "  ✅ PostgreSQL endpoint reachable: ${AZURE_PG_HOST_CHECK}:5432"
    HEALTH_PASS=$((HEALTH_PASS + 1))
  else
    echo "  ⚠️  PostgreSQL endpoint not reachable yet (firewall rules may need time): $AZURE_PG_HOST_CHECK"
    HEALTH_FAIL=$((HEALTH_FAIL + 1))
  fi
fi
{% endif %}

{% if has_s3_migration %}
# Check: Azure Blob Storage reachable
AZURE_SA_CHECK=$(terraform output -raw storage_account_name 2>/dev/null || echo "${AZURE_STORAGE_ACCOUNT_NAME:-}")
if [[ -n "$AZURE_SA_CHECK" ]]; then
  HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
    "https://${AZURE_SA_CHECK}.blob.core.windows.net/" \
    --max-time 10 2>/dev/null || echo "000")
  if [[ "$HTTP_STATUS" =~ ^(200|400|403|404)$ ]]; then
    echo "  ✅ Azure Blob Storage endpoint reachable (HTTP $HTTP_STATUS): ${AZURE_SA_CHECK}"
    HEALTH_PASS=$((HEALTH_PASS + 1))
  else
    echo "  ⚠️  Azure Blob Storage not reachable (HTTP $HTTP_STATUS): ${AZURE_SA_CHECK}"
    HEALTH_FAIL=$((HEALTH_FAIL + 1))
  fi
fi
{% endif %}

{% if has_ai_migration %}
# Check: Azure OpenAI / Cognitive Services endpoint
AZURE_COG_NAME=$(terraform output -raw cognitive_account_name 2>/dev/null || echo "")
if [[ -n "$AZURE_COG_NAME" ]]; then
  COG_STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
    "https://${AZURE_COG_NAME}.openai.azure.com/" \
    --max-time 10 2>/dev/null || echo "000")
  if [[ "$COG_STATUS" =~ ^(200|401|403)$ ]]; then
    echo "  ✅ Azure OpenAI endpoint reachable (HTTP $COG_STATUS): ${AZURE_COG_NAME}.openai.azure.com"
    HEALTH_PASS=$((HEALTH_PASS + 1))
  else
    echo "  ⚠️  Azure OpenAI endpoint not reachable yet (HTTP $COG_STATUS)"
    HEALTH_FAIL=$((HEALTH_FAIL + 1))
  fi
fi
{% endif %}

echo ""
if [[ $HEALTH_FAIL -eq 0 ]]; then
  echo "  ✅ All health checks passed ($HEALTH_PASS/$((HEALTH_PASS + HEALTH_FAIL)))"
else
  echo "  ⚠️  Health checks: $HEALTH_PASS passed, $HEALTH_FAIL warnings"
  echo "     Some services may still be initializing — retry in 2-3 minutes."
fi

echo ""
echo "=== Deployment completed successfully ==="
echo "Check resources: https://portal.azure.com/#home"
echo "Terraform outputs:"
terraform output 2>/dev/null || true
