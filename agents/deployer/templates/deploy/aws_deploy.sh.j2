#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# deploy.sh — AWS Deployment Script
# Generated by Cloud Migrator Agent 03
# Provider : AWS | Region : {{ region }}
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REGION="{{ region }}"
RESOURCES="{{ resources_csv }}"
OUTPUT_DIR="{{ output_dir }}"
TF_WORKSPACE="${TF_WORKSPACE:-default}"

echo "=== Cloud Migrator — AWS Deployment ==="
echo "Region    : $REGION"
echo "Resources : $RESOURCES"
echo "Output    : $OUTPUT_DIR"
echo ""

# ── 1. Validate credentials ──────────────────────────────────────────────────
if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
  echo "ERROR: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY must be set."
  exit 1
fi
echo "[1/5] Credentials: OK (AWS_ACCESS_KEY_ID is set)"

# ── 2. Terraform init ────────────────────────────────────────────────────────
echo "[2/5] terraform init..."
cd "$OUTPUT_DIR"
terraform init -input=false \
  -backend-config="region=${REGION}" \
  {% if backend_bucket %}-backend-config="bucket={{ backend_bucket }}" \{% endif %}
  2>&1 | tee /tmp/tf_init.log
echo "[2/5] Init: OK"

# ── 3. Terraform workspace ───────────────────────────────────────────────────
echo "[3/5] Workspace: $TF_WORKSPACE"
terraform workspace select "$TF_WORKSPACE" 2>/dev/null || terraform workspace new "$TF_WORKSPACE"

# ── 4. Terraform plan (dry-run) ──────────────────────────────────────────────
echo "[4/5] terraform plan..."
terraform plan -input=false -refresh=false \
  -var="region=${REGION}" \
  -out=tfplan.binary 2>&1 | tee /tmp/tf_plan.log
echo "[4/5] Plan: OK"

# ── 5. Terraform apply ───────────────────────────────────────────────────────
echo "[5/5] terraform apply..."
terraform apply -input=false -auto-approve tfplan.binary 2>&1 | tee /tmp/tf_apply.log
echo "[5/5] Apply: DONE"

echo ""
echo "=== Deployment completed successfully ==="
echo "Check resources in AWS console: https://console.aws.amazon.com/?region=${REGION}"
